{
  "name": "FuckLike — 24/7 Queue Batch Trigger",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 10 }] }
      },
      "id": "schedule",
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-40, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/generation_queue?status=eq.pending&order=created_at.asc&limit=5",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "fetch-pending",
      "name": "Fetch Pending Queue Rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 300]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "id": "split-batches",
      "name": "One Persona at a Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/generation_queue?id=eq.{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: \"processing\", started_at: new Date().toISOString() }) }}",
        "options": {}
      },
      "id": "mark-processing",
      "name": "Mark Processing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_SELF_WEBHOOK_URL }}/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.spec.channel || \"nsfw\", ...$json.spec, name: $json.persona_name }) }}",
        "options": { "timeout": 300000 }
      },
      "id": "call-orchestrator",
      "name": "Call Orchestrator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 220]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/generation_queue?id=eq.{{ $('One Persona at a Time').item.json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: $json.ok ? \"done\" : \"error\", drive_file_ids: ($json.files || []).map(f => f.drive_id), error_msg: $json.ok ? null : JSON.stringify($json), finished_at: new Date().toISOString() }) }}",
        "options": {}
      },
      "id": "mark-done",
      "name": "Write Result Back",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 220]
    }
  ],
  "connections": {
    "Every 10 Minutes": {
      "main": [[{ "node": "Fetch Pending Queue Rows", "type": "main", "index": 0 }]]
    },
    "Fetch Pending Queue Rows": {
      "main": [[{ "node": "One Persona at a Time", "type": "main", "index": 0 }]]
    },
    "One Persona at a Time": {
      "main": [[{ "node": "Mark Processing", "type": "main", "index": 0 }]]
    },
    "Mark Processing": {
      "main": [[{ "node": "Call Orchestrator", "type": "main", "index": 0 }]]
    },
    "Call Orchestrator": {
      "main": [[{ "node": "Write Result Back", "type": "main", "index": 0 }]]
    },
    "Write Result Back": {
      "main": [[{ "node": "One Persona at a Time", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
