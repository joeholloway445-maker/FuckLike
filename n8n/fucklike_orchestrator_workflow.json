{
  "name": "FuckLike / Periliminal — Generation Orchestrator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Persona Request Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-40, 300],
      "webhookId": "fucklike-generate"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.channel }}",
                    "rightValue": "nsfw",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "nsfw"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.channel }}",
                    "rightValue": "sfw",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "sfw"
            }
          ]
        },
        "options": {}
      },
      "id": "channel-switch",
      "name": "Route by Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PERCHANCE_ROUTER_URL }}/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": { "timeout": 300000 }
      },
      "id": "call-perchance",
      "name": "Perchance NSFW Generate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KAGGLE_COLAB_SFW_URL }}/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": { "timeout": 300000 }
      },
      "id": "call-sfw",
      "name": "Kaggle/Colab SFW Generate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.needs_review }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equal" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "needs-review-check",
      "name": "Needs Manual Review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.REVIEW_ALERT_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ persona: $json.persona, rejected_count: $json.rejected_count, rejected_reasons: $json.rejected_reasons }) }}",
        "options": {}
      },
      "id": "notify-review",
      "name": "Notify Needs-Review Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Caller",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [1180, 300]
    }
  ],
  "connections": {
    "Persona Request Webhook": {
      "main": [[{ "node": "Route by Channel", "type": "main", "index": 0 }]]
    },
    "Route by Channel": {
      "main": [
        [{ "node": "Perchance NSFW Generate", "type": "main", "index": 0 }],
        [{ "node": "Kaggle/Colab SFW Generate", "type": "main", "index": 0 }]
      ]
    },
    "Perchance NSFW Generate": {
      "main": [[{ "node": "Needs Manual Review?", "type": "main", "index": 0 }]]
    },
    "Needs Manual Review?": {
      "main": [
        [{ "node": "Notify Needs-Review Queue", "type": "main", "index": 0 }],
        [{ "node": "Respond to Caller", "type": "main", "index": 0 }]
      ]
    },
    "Notify Needs-Review Queue": {
      "main": [[{ "node": "Respond to Caller", "type": "main", "index": 0 }]]
    },
    "Kaggle/Colab SFW Generate": {
      "main": [[{ "node": "Respond to Caller", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
